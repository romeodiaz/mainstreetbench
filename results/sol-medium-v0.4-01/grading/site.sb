(version 1)
(deny default)
(allow process-fork process-exec)
(allow signal (target same-sandbox))
(allow file-map-executable)
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read* (subpath "/System/Library") (subpath "/System/Volumes/Preboot") (subpath "/usr/bin") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library/Apple") (subpath "/private/preboot") (subpath "/private/var/db/dyld") (subpath "/Users/romeodiaz/Documents/BenchRuns/mainstreetbench/v0.4-grader-preflight/runtime") (subpath "/Users/romeodiaz/.cache/codex-runtimes/codex-primary-runtime/dependencies/python") (subpath "/Users/romeodiaz/Documents/BenchRuns/mainstreetbench/v0.4-sol-medium-20261001T053309Z/frozen") (subpath "/Users/romeodiaz/Documents/BenchRuns/mainstreetbench/v0.4-sol-medium-20261001T053309Z/grading/trusted/tasks/ordering-site/starter") (subpath "/Users/romeodiaz/Documents/BenchRuns/mainstreetbench/v0.4-sol-medium-20261001T053309Z/grading/scratch/tmp") (subpath "/Users/romeodiaz/Documents/BenchRuns/mainstreetbench/v0.4-sol-medium-20261001T053309Z/grading/scratch/grader-home") (subpath "/private/var/db/timezone") (literal "/private/etc/localtime") (literal "/") (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom"))
(allow file-write* (subpath "/Users/romeodiaz/Documents/BenchRuns/mainstreetbench/v0.4-sol-medium-20261001T053309Z/grading/scratch/tmp") (literal "/dev/null"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
